{
  "name": "stitching-app-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production node ./bin/www",
    "start:socket": "NODE_ENV=production node ./socket.js",
    "sync": "NODE_ENV=syncing PORT=3001 nodemon ./bin/www",
    "dev": "npx nodemon ./bin/www",
    "dev:socket": "npx nodemon ./socket.js",
    "lint": "npx eslint ./",
    "lint:fix": "npx eslint ./ --fix",
    "swagger": "swagger-editor-live -p 8080 public/swagger/swagger.yaml",
    "test": "node --expose-gc ./node_modules/.bin/jest tests/auth.test.js --runInBand --forceExit",
    "feed": "node --expose-gc ./node_modules/.bin/jest tests/feed.test.js --runInBand  --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "async-lock": "^1.4.1",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "~4.18.2",
    "jsonwebtoken": "^9.0.0",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.4.1",
    "morgan": "~1.10.0",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/jest": "^29.2.5",
    "babel-cli": "^6.26.0",
    "eslint": "^8.32.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.27.4",
    "jest": "^29.3.1",
    "jest-html-reporters": "^3.0.11",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
